# Copy this file to `.env` and fill in as needed.
# `.env` is gitignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Chain selection (required)
# ---------------------------------------------------------------------------
# Which network the app targets. One of: electroneum | mainnet | sepolia | localhost
NEXT_PUBLIC_CHAIN_NAME=electroneum

# Only used when NEXT_PUBLIC_CHAIN_NAME=electroneum. One of: testnet | mainnet
NEXT_PUBLIC_ETN_NETWORK=testnet

# ---------------------------------------------------------------------------
# Electroneum chain config (required for the active network above)
# ---------------------------------------------------------------------------
# RPC endpoints. Both have public fallbacks baked in (rpc.ankr.com) if left unset.
NEXT_PUBLIC_ETN_TESTNET_RPC_URL=https://rpc.ankr.com/electroneum_testnet/
# NEXT_PUBLIC_ETN_MAINNET_RPC_URL=

# Deployed ENS contract addresses per network (public on-chain addresses, not secret).
NEXT_PUBLIC_ETN_TESTNET_DEPLOYMENT_ADDRESSES={"ENSRegistry":"0x2466B8Ef6Bedd1b48FA7e0CdBeBc2300d913C701","UniversalResolver":"0xEe1f847de4d2DA11E46328B83d7551771D8f778c","BaseRegistrarImplementation":"0x7b787b31Ad58D563D7B3938b4bbfAB2c588624C5","ETHRegistrarController":"0x5BFb2958062Ac12d2019Ac1E69243DDbafCCc2c5","PublicResolver":"0x1B148DF21F18cFaEC68b71FBF11692F569658b3D","ReverseRegistrar":"0x470680Df59dB243409F67ec7EaC78D8e6f834047","Multicall":"0xcA11bde05977b3631167028862bE2a173976CA11","NameWrapper":"0x388f495A886644883F41a5958C11382e7c0D23F5"}
NEXT_PUBLIC_ETN_MAINNET_DEPLOYMENT_ADDRESSES={"ENSRegistry":"0x6F311F2212593165988Dff84977e24C1005dBb85","UniversalResolver":"0x75509153af7db00BeeCc30EC042299fD30e2cb6e","BaseRegistrarImplementation":"0x5207496C1248BbD2AeeDd57Bde44dd9d4E9F1b59","ETHRegistrarController":"0x3CFa6D6E7e1216393C2cb9393Bc0f411492E33e9","PublicResolver":"0xDb4A3Abb6703232e20a118a104e7f4EbB3e2738D","ReverseRegistrar":"0xFBB14eDBD8D3f6E7BB240bFA388f6582df0d8E7A","Multicall":"0xcA11bde05977b3631167028862bE2a173976CA11","NameWrapper":"0xd8F4B1A91469B05d9E0b15Cac4917Ee47b2A6f64"}

# Subgraph endpoints. If left unset, falls back to a local subgraph
# (http://localhost:42069/subgraph) — search, profile records, and name
# history won't resolve real data without a real one set here.
# NEXT_PUBLIC_ETN_TESTNET_SUBGRAPH_URL=
# NEXT_PUBLIC_ETN_MAINNET_SUBGRAPH_URL=

# ---------------------------------------------------------------------------
# Third-party services (all optional — each falls back to a shared/demo key
# baked into the code, so the app runs without any of these)
# ---------------------------------------------------------------------------
# Alchemy — used for NFT/avatar metadata lookups. Falls back to a non-working
# placeholder, so avatar image fetching won't work without a real key.
# NEXT_PUBLIC_ALCHEMY_KEY=your-alchemy-api-key

# PostHog analytics. Analytics are simply disabled if unset.
# NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Thirdweb / Unicorn embedded wallet connector.
# NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your-thirdweb-client-id
# Note: this exact double "NEXT_PUBLIC_NEXT_PUBLIC_" prefix is what the code reads.
# NEXT_PUBLIC_NEXT_PUBLIC_UNICORN_FACTORY_ADDRESS=0xYourUnicornFactoryAddress

# Para embedded wallet connector. Falls back to a beta/demo key if unset.
# NEXT_PUBLIC_PARA_API_KEY_PROD=your-para-prod-api-key

# Intercom support widget.
# NEXT_PUBLIC_INTERCOM_ID=your-intercom-app-id

# dRPC / Tenderly RPC providers used for fallback transports. Both have shared
# demo keys baked in if unset.
# NEXT_PUBLIC_DRPC_KEY=your-drpc-key
# NEXT_PUBLIC_TENDERLY_KEY=your-tenderly-key

# Avatar upload worker endpoint. Falls back to https://euc.li if unset.
# NEXT_PUBLIC_AVUP_ENDPOINT=

# ---------------------------------------------------------------------------
# Local development flags (optional)
# ---------------------------------------------------------------------------
# Set when running against a local anvil chain (see "Local devnet" below) —
# enables local-chain-specific behavior (e.g. skips block-based query
# invalidation, uses local resolver addresses).
# NEXT_PUBLIC_ETH_NODE=anvil

# RPC URL for a local anvil chain, set automatically by `pnpm denv`/`pnpm dev:glocal`.
# NEXT_PUBLIC_PROVIDER=http://localhost:8545

# Enables extra ENSJS debug logging.
# NEXT_PUBLIC_ENSJS_DEBUG=false

# Set when building/exporting a static IPFS build (`pnpm export`).
# NEXT_PUBLIC_IPFS=false

# Mock wallet for local dev without a real browser wallet extension.
# NEXT_PUBLIC_USE_MOCK_WALLET=false
# NEXT_PUBLIC_MOCK_ACCOUNT=

# ---------------------------------------------------------------------------
# Local devnet + e2e test env (see README "Setting up the development
# environment" — requires Docker). Populated/consumed by `pnpm tenv` /
# `pnpm denv` and the Playwright test suite.
# ---------------------------------------------------------------------------
# Well-known local test mnemonic — not a real secret, used by ens-test-env,
# Playwright fixtures, and MetaMask e2e automation. Keep as-is for local/CI use.
SECRET_WORDS="test test test test test test test test test test test junk"
# MetaMask password used by wallet e2e tests against the local devnet.
PASSWORD=TestMetaMask

NETWORK_NAME=localhost
GRAPH_URL=http://localhost:8000
DATA_FOLDER=./data
BLOCK_HEIGHT=12066620
SUBGRAPH_ID=QmXxAE7Urtv6TPa8o8XmPwLVQNbH6r35hRKHP63udTxTNa
LOCAL_SUBGRAPH_ID=QmSUnR4AUTQ8CuGH2fK7tFTSSfYGe8BUz6EeBRNavXbE1H
EPOCH_TIME=1660180306
NETWORK=mainnet
ARCHIVE_URL=https://storage.googleapis.com/ens-manager-build-data

TRANSACTION_WAIT_TIME=5000
STABLE_MODE=500
BATCH_GATEWAY_URLS='["https://ccip-v2.ens.xyz/"]'

# Stateful e2e target chain (e.g. mainnet | sepolia) — only used by the
# stateful/wallet Playwright projects, not the stateless suite.
# CHAIN=sepolia

# NOTE: NEXT_PUBLIC_DEPLOYMENT_ADDRESSES (for the plain `localhost` chain,
# distinct from the NEXT_PUBLIC_ETN_* ones above) is written automatically to
# `.env.local` by `pnpm tenv start` / `pnpm denv` — you don't set it by hand.
