# Production build configuration — Electroneum MAINNET.
#
# Every NEXT_PUBLIC_* value here is BAKED INTO THE CLIENT BUNDLE at `next
# build` time. Changing any of them requires a rebuild + redeploy, not an
# env flip on the running container. See DEPLOY.md.
#
# Values can be overridden at image build time via docker build args of the
# same name (see Dockerfile), e.g. by Coolify build-time variables.

NEXT_PUBLIC_CHAIN_NAME=electroneum
NEXT_PUBLIC_ETN_NETWORK=mainnet

NEXT_PUBLIC_ETN_MAINNET_RPC_URL=https://rpc.electroneum.com

NEXT_PUBLIC_ETN_MAINNET_DEPLOYMENT_ADDRESSES={"ENSRegistry":"0x6F311F2212593165988Dff84977e24C1005dBb85","UniversalResolver":"0x75509153af7db00BeeCc30EC042299fD30e2cb6e","BaseRegistrarImplementation":"0x5207496C1248BbD2AeeDd57Bde44dd9d4E9F1b59","ETHRegistrarController":"0x3CFa6D6E7e1216393C2cb9393Bc0f411492E33e9","PublicResolver":"0xDb4A3Abb6703232e20a118a104e7f4EbB3e2738D","ReverseRegistrar":"0xFBB14eDBD8D3f6E7BB240bFA388f6582df0d8E7A","Multicall":"0xcA11bde05977b3631167028862bE2a173976CA11","NameWrapper":"0xd8F4B1A91469B05d9E0b15Cac4917Ee47b2A6f64","WrappedStaticBulkRenewal":"0x8acdf3703ff6182f265f5c910f6ecc2d96cec77d"}

NEXT_PUBLIC_ETN_MAINNET_SUBGRAPH_URL=https://subgraph.electroneum.com/subgraphs/name/etn-subgraph

